# SearXNG 配置（必需）
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_API_KEY=
SEARXNG_SECRET_KEY=
SEARXNG_SECRET=

# 请求配置
REQUEST_TIMEOUT=15000
CACHE_TTL=300
CACHE_MAX_SIZE=100
RATE_LIMIT_RPM=30

# 其他
USER_AGENT=UAF-WebResearch/1.0
LOG_LEVEL=info
NODE_ENV=development

# Transport: stdio | sse
MCP_TRANSPORT=sse
SSE_PORT=3456